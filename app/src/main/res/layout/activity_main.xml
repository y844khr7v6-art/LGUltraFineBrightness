<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="LG UltraFine" android:textAppearance="?attr/textAppearanceHeadline5" android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton android:id="@+id/overflowMenu" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp" android:text="⋮" android:textSize="24sp" android:contentDescription="More options" />
        </LinearLayout>
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Looking for your UltraFine…" android:textAppearance="?attr/textAppearanceBody1" />

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" app:cardUseCompatPadding="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Brightness" android:textAppearance="?attr/textAppearanceSubtitle1" android:textStyle="bold" />
                <TextView android:id="@+id/value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="50%" android:textAppearance="?attr/textAppearanceHeadline3" android:textStyle="bold" />
                <SeekBar android:id="@+id/slider" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:max="100" android:progress="50" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/b25" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="25%" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/b50" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="50%" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/b75" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="75%" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/b100" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="100%" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardUseCompatPadding="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ambient brightness" android:textAppearance="?attr/textAppearanceSubtitle1" android:textStyle="bold" />
                <TextView android:id="@+id/alsValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="— lux" android:textAppearance="?attr/textAppearanceHeadline4" android:textStyle="bold" />
                <TextView android:id="@+id/autoInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="MANUAL · Day" android:textAppearance="?attr/textAppearanceBody2" />
                <com.google.android.material.button.MaterialButton android:id="@+id/autoToggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Enable Auto ALS" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Profile" android:textAppearance="?attr/textAppearanceCaption" />
                <Spinner android:id="@+id/profileSpinner" android:layout_width="match_parent" android:layout_height="48dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/resetPreference" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reset learned preference" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton android:id="@+id/reconnect" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Reconnect" />

        <LinearLayout android:id="@+id/expertSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Expert Mode" android:textAppearance="?attr/textAppearanceHeadline6" android:textStyle="bold" />
            <TextView android:id="@+id/alsRaw" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="ALS raw data appears here." android:textAppearance="?attr/textAppearanceCaption" android:fontFamily="monospace" />
            <com.google.android.material.button.MaterialButton android:id="@+id/read" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Read hardware brightness" />
            <com.google.android.material.button.MaterialButton android:id="@+id/probeAls" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Probe HID ALS · Interface 2" />
            <com.google.android.material.button.MaterialButton android:id="@+id/probeI2c" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Probe HID I2C · Interface 0" />
            <com.google.android.material.button.MaterialButton android:id="@+id/probeAll" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Probe all interfaces · read-only" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="24dp" app:cardUseCompatPadding="true">
                <TextView android:id="@+id/probeOutput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="180dp" android:padding="16dp" android:text="HID diagnostics appear here." android:textIsSelectable="true" android:textSize="12sp" android:fontFamily="monospace" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
